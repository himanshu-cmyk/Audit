// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// An audit result imported by a merchant. findingsJson holds the validated,
// normalised findings (never executable content). Store modifications are only
// allowed when storeMatch is MATCHED, or MISMATCH with an explicit confirmation.
model AuditImport {
  id                 String         @id @default(cuid())
  shop               String
  sourceFormat       String
  fileName           String?
  auditedUrl         String?
  auditedHost        String?
  auditDate          DateTime?
  overallScore       Int?
  grade              String?
  findingCount       Int
  findingsJson       String
  importWarnings     String?
  storeMatch         String
  storeMatchNote     String?
  storeConfirmedAt   DateTime?
  storeConfirmedHost String?
  // Internal report contract (app/fixes/reportContract.server.js). Null for
  // imports made before contract version 1.
  contractVersion     Int?
  sourceSchemaVersion Int?
  rawSha256           String?
  contentDigest       String?
  sourceGeneratedAt   DateTime?
  reportJson          String?
  // Unpublished/development theme chosen once for this audit's theme fixes.
  themeId             String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  fixes              FixExecution[]

  // Re-importing identical content in the same shop returns the existing import.
  @@unique([shop, contentDigest])
  @@index([shop, createdAt])
}

// One reviewable, executable change to one Shopify resource, plus its audit trail.
model FixExecution {
  id                 String      @id @default(cuid())
  shop               String
  importId           String
  import             AuditImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  findingKey         String
  fixType            String
  executionKind      String
  resourceType       String
  resourceId         String
  parentResourceId   String?
  resourceLabel      String?
  targetUrl          String?
  dedupeKey          String
  // Set when this change restores the previous state of another change.
  rollbackOfId       String?
  // Incremented on every review-relevant change. An approval binds one revision.
  revision           Int         @default(1)
  beforeJson         String
  proposedJson       String
  approvedJson       String?
  resultJson         String?
  status             String
  verificationStatus String
  verificationJson   String?
  liveCheckJson      String?
  errorMessage       String?
  retryable          Boolean     @default(false)
  attempts           Int         @default(0)
  approvedAt         DateTime?
  appliedAt          DateTime?
  verifiedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([shop, dedupeKey])
  @@index([shop, importId])
  @@index([shop, updatedAt])
}

// Original content of a theme file, saved immediately before the app writes to it.
model ThemeFileBackup {
  id            String   @id @default(cuid())
  shop          String
  executionId   String
  themeId       String
  filename      String
  checksumMd5   String?
  contentSha256 String
  content       String
  createdAt     DateTime @default(now())

  @@index([shop, executionId])
}

// An AI recommendation or analysis. Advisory only: it is never executed. A
// merchant may copy a VALID proposedValue into a change, which is then approved
// and applied through the normal FixExecution workflow.
model AiSuggestion {
  id             String   @id @default(cuid())
  shop           String
  importId       String
  findingKey     String
  executionId    String?
  kind           String
  provider       String
  model          String
  promptVersion  String
  status         String
  outputJson     String?
  validationJson String?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, executionId])
  @@index([shop, importId, findingKey])
}
